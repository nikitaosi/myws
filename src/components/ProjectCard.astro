---
import {Image} from 'astro:assets';
import type {ImageMetadata} from 'astro';
import TechBadge from './TechBadge.astro';
import type {Technology} from '../lib/technology-colors';

interface Props {
  content: {
    title: string;
    preview?: {src: ImageMetadata; alt: string; caption: string};
    note?: string;
    live?: {url: string; label: string};
    description: string;
    technologies: Technology[];
    repositories: { label: string; url: string; private: boolean }[];
  };
}

const {title, description, technologies, repositories, preview, note, live} = Astro.props.content;
---

<article class="border rounded-[20px] p-4 border-[rgb(var(--color-card))]">
  <h2 class="font-bold">{title}</h2>
  {preview && <figure class="mt-4">
    <Image src={preview.src} alt={preview.alt} widths={[320, 640, 960]} sizes="(max-width: 720px) calc(100vw - 72px), 640px" class="w-full h-auto max-h-96 object-contain bg-skin-base/5 rounded-xl border border-skin-base/10" loading="lazy" />
    <figcaption class="mt-2 text-sm text-skin-base/70">{preview.caption}</figcaption>
  </figure>}
  <p class="mt-3">{description}</p>
  {note && <p class="mt-3 text-sm text-skin-base/70">{note}</p>}
  <div class="flex flex-row flex-wrap pt-4">
    {technologies.map((name) => <TechBadge name={name} />)}
  </div>
  <div class="flex flex-wrap gap-x-6 gap-y-2 mt-4">
    {live && <a href={live.url} target="_blank" rel="noopener noreferrer" class="text-sm text-skin-accent underline underline-offset-4 hover:opacity-80 focus-visible:outline-2 focus-visible:outline-offset-4 rounded-sm">{live.label} ↗</a>}
    {repositories.map((repository) => (
      <div class="inline-flex items-center gap-2">
        <a
          href={repository.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${repository.label} for ${title} on GitHub${repository.private ? ' (private repository)' : ''}`}
          class="inline-flex items-center gap-1.5 text-sm text-skin-accent hover:opacity-80 focus-visible:outline-2 focus-visible:outline-offset-4 rounded-sm transition-opacity"
        >
          <span aria-hidden="true" class="size-4 shrink-0 bg-current mask-[url(/icons/github.svg)] mask-contain mask-center mask-no-repeat" />
          <span class="underline underline-offset-4">{repository.label}</span>
          <span aria-hidden="true">↗</span>
        </a>
        {repository.private && (
          <span class="text-[10px] leading-4 font-medium text-skin-base/60 bg-skin-base/5 border border-skin-base/15 rounded px-1.5 py-0.5">Private</span>
        )}
      </div>
    ))}
  </div>
</article>
