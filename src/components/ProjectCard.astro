---
import TechBadge from './TechBadge.astro';
import type {Technology} from '../lib/technology-colors';

interface Props {
  content: {
    title: string;
    description: string;
    technologies: Technology[];
    repositories: { label: string; url: string; private: boolean }[];
  };
}

const {title, description, technologies, repositories} = Astro.props.content;
---

<article class="border rounded-[20px] p-4 border-[rgb(var(--color-card))]">
  <h3 class="font-bold">{title}</h3>
  <p class="mt-3">{description}</p>
  <div class="flex flex-row flex-wrap pt-4">
    {technologies.map((name) => <TechBadge name={name} />)}
  </div>
  <div class="flex flex-wrap gap-x-6 gap-y-2 mt-4">
    {repositories.map((repository) => (
      <div class="inline-flex items-center gap-2">
        <a
          href={repository.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${repository.label} for ${title} on GitHub${repository.private ? ' (private repository)' : ''}`}
          class="inline-flex items-center gap-1.5 text-sm text-skin-accent hover:opacity-80 focus-visible:outline-2 focus-visible:outline-offset-4 rounded-sm transition-opacity"
        >
          <span aria-hidden="true" class="size-4 shrink-0 bg-current mask-[url(/icons/github.svg)] mask-contain mask-center mask-no-repeat" />
          <span class="underline underline-offset-4">{repository.label}</span>
          <span aria-hidden="true">↗</span>
        </a>
        {repository.private && (
          <span class="text-[10px] leading-4 font-medium text-skin-base/60 bg-skin-base/5 border border-skin-base/15 rounded px-1.5 py-0.5">Private</span>
        )}
      </div>
    ))}
  </div>
</article>
