---
const consent = Astro.cookies.get('analytics_consent')?.value;
const hasChoice = consent === 'granted' || consent === 'denied';
---

<footer class="mb-6 text-sm text-skin-base/70">
  <button type="button" data-analytics-preferences class="underline underline-offset-4 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-4" hidden>Analytics preferences</button>
</footer>
<section data-analytics-banner hidden={hasChoice} aria-label="Optional analytics" class="fixed bottom-4 left-4 right-4 z-50 ml-auto max-w-xs rounded-lg border border-skin-base/20 bg-skin-fill p-3 shadow-lg">
  <p class="text-xs leading-5">Allow Google Analytics cookies for visitor and traffic-source stats? <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer" class="text-skin-accent underline underline-offset-2">Privacy ↗</a></p>
  <div class="mt-2 flex gap-2">
    <button type="button" disabled data-analytics-choice="denied" aria-label="Reject analytics" class="rounded-md border border-skin-base/30 px-3 py-1.5 text-xs font-medium cursor-pointer hover:bg-skin-base/5 focus-visible:outline-2 focus-visible:outline-offset-4 disabled:opacity-50">Reject</button>
    <button type="button" disabled data-analytics-choice="granted" aria-label="Accept analytics" class="rounded-md border border-skin-base/30 px-3 py-1.5 text-xs font-medium cursor-pointer hover:bg-skin-base/5 focus-visible:outline-2 focus-visible:outline-offset-4 disabled:opacity-50">Accept</button>
  </div>
  <noscript><p class="mt-2 text-xs">JavaScript is disabled; analytics is off.</p></noscript>
</section>
<script>
  import '../lib/analytics';
</script>
