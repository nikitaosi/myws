---
export const prerender = false;
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Work experience";

type Experience = {
  company: string;
  position: string;
  duration: string;
  description?: string;
  projects?: { title: string; descriptionList: string[] }[];
};

const experiences: Experience[] = [
  {
    company: 'EPAM Systems',
    position: 'Frontend Engineer',
    duration: 'Jun 2024 - Aug 2026',
    projects: [
      {
        title: 'Cosmetics e-commerce platform',
        descriptionList: [
          'Developed a new regional e-commerce frontend with Next.js, React, TypeScript and shadcn/ui.',
          'Implemented wishlist functionality, built responsive interfaces and collaborated with backend engineers on the underlying data model.',
        ],
      },
      {
        title: 'Education platform',
        descriptionList: [
          'Built and maintained features using React, Next.js and TypeScript with SSR, including UI redesigns and reusable components.',
          'Participated in the Adobe Experience Manager release process and resolved critical production issues.',
        ],
      },
      {
        title: 'Insurance platform - shared UI kit',
        descriptionList: [
          'Developed shared components using React and Next.js in a Tailwind CSS and Yarn Workspaces monorepo, supporting multiple product themes.',
          'Maintained theme-specific behavior and used AI-assisted workflows to propagate repetitive changes consistently across themes.',
        ],
      },
    ],
  },
  {
    company: 'Independent Contractor',
    position: 'Frontend Developer',
    description: 'Built personal web products and an educational platform using React, Next.js, TypeScript, Astro, Strapi and NestJS.',
    duration: 'May 2023 - Jun 2024',
  },
  {
    company: 'Sberbank',
    position: 'Frontend Engineer and Team Lead',
    description: 'Led frontend development across three product teams over the course of the role. Launched and maintained media, education and interactive products, improved performance and mentored engineers.',
    duration: 'Apr 2021 - Apr 2023',
  },
  {
    company: 'Business Integration',
    position: 'Frontend Engineer',
    description: 'Refactored an internal service-status dashboard for Sberbank using TypeScript, React and Next.js.',
    duration: 'Dec 2020 - Apr 2021',
  },
  {
    company: 'Triumph Group',
    position: 'Frontend Engineer',
    description: 'Developed browser-based CAD tools for clothing design and sewing patterns; contributed to planning and mentored six new developers.',
    duration: 'Sep 2019 - Sep 2020',
  },
  {
    company: 'Freelance',
    position: 'Frontend Engineer',
    description: 'Developed six browser games with TypeScript and Phaser.js, plus a freelance web game project.',
    duration: 'Nov 2018 - Jul 2019',
  },
  {
    company: 'RD Express',
    position: 'Developer',
    description: 'Built commerce and fulfillment bots with product search, delivery and inventory features; integrated external APIs.',
    duration: 'Jun 2018 - Nov 2018',
  },
  {
    company: 'GMsite',
    position: 'Web Developer',
    description: 'Delivered website designs, frontend and backend maintenance, and bug fixes for web-studio clients.',
    duration: 'Jan 2018 - Jun 2018',
  },
];
---

<BaseLayout title={`${title} — Nikita Osipov`} description="Nikita Osipov's frontend engineering experience, including EPAM Systems, Sberbank, team leadership and production React and Next.js applications.">
  <section class="flex flex-col items-center justify-center py-14 text-left">
    <div class="mx-auto">
      <h2 class="text-2xl font-semibold">{title}</h2>
      <div class="divide-y divide-solid divide-[rgb(var(--color-divide))]">
        {experiences.map(({company, position, description, duration, projects}) => (
          <div class="py-16 flex flex-col">
            <h3 class="text-xl font-semibold">{company}</h3>
            <span class="mt-2">{position}</span>
            <span class="mb-4 opacity-70">{duration}</span>
            {description && <p>{description}</p>}
            {projects?.map(({title, descriptionList}) => (
              <div class="mt-4">
                <h4 class="font-semibold mb-2">{title}</h4>
                <ul class="list-disc pl-4 space-y-1">
                  {descriptionList.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
