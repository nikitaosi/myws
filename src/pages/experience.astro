---
export const prerender = false;
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Work experience";

type Experience = {
  company: string;
  position: string;
  duration: string;
  description?: string;
  projects?: { title: string; descriptionList: string[] }[];
};

const experiences: Experience[] = [
  {
    company: 'EPAM Systems',
    position: 'Frontend Engineer',
    duration: 'Jun 2024 - Aug 2026',
    projects: [
      {
        title: 'Cosmetics e-commerce platform',
        descriptionList: [
          'Developed production features using Next.js, React, TypeScript, and shadcn/ui for a regional e-commerce platform.',
          'Independently implemented wishlist functionality from scratch based on Figma designs, including responsive UI components.',
          'Collaborated with frontend and backend engineers on user settings, authentication-related interfaces, and API integrations.',
        ],
      },
      {
        title: 'Education platform',
        descriptionList: [
          'Developed and maintained production features using React, Next.js (App Router), and TypeScript, including reusable UI components and server-rendered pages.',
          'Implemented frontend features, redesigned product search interfaces, and integrated UI functionality with existing services, including Algolia.',
          'Worked across Next.js and Adobe Experience Manager (AEM), building components, updating pages, and resolving production issues such as hydration mismatches and rendering bugs.',
        ],
      },
      {
        title: 'Insurance platform — Shared UI library',
        descriptionList: [
          'Developed and maintained a shared React component library using TypeScript, Next.js, Tailwind CSS, and Yarn Workspaces.',
          'Built reusable, theme-aware components distributed as an npm package and integrated across multiple applications.',
          'Maintained consistent UI behavior across product themes, using AI-assisted workflows to streamline repetitive changes.',
        ],
      },
    ],
  },
  {
    company: 'Independent Contractor',
    position: 'Frontend Developer',
    description: 'Built a commercial educational platform and independent products, including an expense tracker and a ChatGPT-based application, using React, Next.js, and TypeScript.',
    duration: 'May 2023 - Jun 2024',
  },
  {
    company: 'Sberbank',
    position: 'Frontend Engineer',
    description: 'Developed media, educational, and interactive products across three teams, contributing to code reviews, technical planning, and mentoring other engineers.',
    duration: 'Dec 2020 - Apr 2023',
  },
  {
    company: 'Triumph Group',
    position: 'Frontend Engineer',
    description: 'Developed browser-based CAD tools for garment design, working with Canvas, a custom WebGL-based 3D engine, and Google Polymer for 2D interfaces; mentored six developers.',
    duration: 'Sep 2019 - Sep 2020',
  },
  {
    company: 'Freelance & Independent Projects',
    position: 'Developer',
    description: 'Built a Telegram-based order fulfillment system with product catalogs, inventory tracking, and delivery management; developed browser games using TypeScript and Phaser.js, including a paid client project.',
    duration: 'Jun 2018 - Jul 2019',
  },
  {
    company: 'GMsite',
    position: 'Web Developer',
    description: 'Built and maintained websites using WordPress, Drupal, and Bitrix, including page layouts, content management, database exports, PHP modifications, and bug fixes.',
    duration: 'Jan 2018 - Jun 2018',
  },
];
---

<BaseLayout title={`${title} — Nikita Osipov`} description="Nikita Osipov's frontend engineering experience: commercial React, Next.js and TypeScript work at EPAM Systems and Sberbank, plus independent projects." pageType="AboutPage">
  <section class="flex flex-col items-center justify-center py-14 text-left">
    <div class="mx-auto">
      <h1 class="text-2xl font-semibold">{title}</h1>
      <p class="mt-3">Production React, Next.js and TypeScript work across e-commerce, education, shared UI libraries and interactive products.</p>
      <p class="mt-3"><a href="/contact/" class="text-skin-accent underline underline-offset-4">Get in touch</a> to discuss a role or a frontend contract.</p>
      <div class="divide-y divide-solid divide-[rgb(var(--color-divide))]">
        {experiences.map(({company, position, description, duration, projects}) => (
          <div class="py-10 flex flex-col">
            <h2 class="text-xl font-semibold">{company}</h2>
            <span class="mt-2">{position}</span>
            <span class="mb-4 opacity-70">{duration}</span>
            {description && <p>{description}</p>}
            {projects?.map(({title, descriptionList}) => (
              <div class="mt-4">
                <h3 class="font-semibold mb-2">{title}</h3>
                <ul class="list-disc pl-4 space-y-1">
                  {descriptionList.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
