---
export const prerender = false;
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Contacts from '../components/Contacts.astro';
import {Image} from 'astro:assets';
import photo from '../images/photo.jpg';
const name = "Nikita Osipov";
const description = "Frontend Engineer";
const technologies = [
  'JavaScript',
  'TypeScript',
  'React',
  'Next.js',
  'Tailwind CSS',
  'Responsive Design',
  'Redux',
  'React Query',
  'GraphQL',
  'Jest',
  'Vitest',
  'Cypress',
  'React Testing Library',
  'Git',
  'Claude Code',
  'Codex',
  'AI Integration'
];
---

<BaseLayout title={name}>
  <section class="flex flex-col items-center justify-center mt-8 text-left">
    <div class="w-full sm:mt-10 flex flex-row items-center self-start justify-between sm:items-end">
      <div class="flex flex-col align-middle">
        <p class="text-base mb-1.5 font-medium select-none">{description}</p>
        <h1 class="text-3xl md:text-5xl font-bold mb-2 max-w-64 whitespace-nowrap select-none">{name}</h1>
      </div>
      <Image src={photo} alt="that's me"
             class="w-24 h-24 sm:w-32 sm:h-32 object-cover rounded-full dark:grayscale-[20%] select-none"/>
    </div>
    <Contacts/>
    <ul class='w-full mb-2'>
      <li>
        <span><b>Location: </b>Thailand</span>
      </li>
      <li>
        <span><b>Format: </b>part-time, project-based or full-time remote</span>
      </li>
    </ul>
    <p class="my-2 self-start text-md">Frontend Engineer with 6+ years of commercial experience building production applications with React, TypeScript and Next.js. My work spans frontend architecture, reusable components, SSR and performance optimization, alongside team leadership and release delivery. I also use AI-assisted development tools such as Claude Code and Codex in my daily workflow.</p>
    <p class="my-2 self-start text-md">Open to new opportunities.</p>
  </section>
  <section class="mt-8">
    <h2 class="text-2xl font-semibold mb-2 sm:mb-8">Skills</h2>
    <ul class="flex flex-wrap gap-2 mb-8 sm:mb-16">
      {technologies.map((technology) => (
          <li class="px-3 py-1 rounded-md bg-skin-base/5 text-sm whitespace-nowrap">
            {technology}
          </li>
      ))}
    </ul>
  </section>
</BaseLayout>
