---
export const prerender = false;
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Contacts from '../components/Contacts.astro';
import {Image} from 'astro:assets';
import photo from '../images/photo.jpg';
import {profile} from '../lib/profile';
const {name, jobTitle: description, skills: technologies} = profile;
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': new URL('/#person', Astro.site).href,
  name,
  jobTitle: profile.jobTitle,
  description: profile.description,
  url: new URL('/', Astro.site).href,
  knowsAbout: profile.skills,
  sameAs: profile.sameAs,
};
---

<BaseLayout title={`${name} — ${description}`} description={profile.description} structuredData={person}>
  <section class="flex flex-col items-center justify-center mt-8 text-left">
    <div class="w-full sm:mt-10 flex flex-row flex-wrap gap-4 items-center self-start justify-between sm:items-end">
      <div class="flex flex-col align-middle">
        <p class="text-base mb-1.5 font-medium select-none">{description}</p>
        <h1 class="text-3xl md:text-5xl font-bold mb-2 max-w-64 whitespace-nowrap select-none">{name}</h1>
      </div>
      <Image src={photo} alt="Nikita Osipov"
             class="w-24 h-24 sm:w-32 sm:h-32 object-cover rounded-full dark:grayscale-[20%] select-none"/>
    </div>
    <div class="flex flex-wrap gap-4 items-center self-start mt-6">
      <a href="/contact/" class="inline-flex items-center px-4 py-2 text-sm rounded-lg bg-skin-accent text-skin-inverted font-semibold focus-visible:outline-2 focus-visible:outline-offset-4 hover:opacity-85">Get in touch</a>
      <a href="/experience/" class="text-skin-accent underline underline-offset-4">View commercial experience →</a>
    </div>
    <Contacts/>
    <ul class='w-full mb-2'>
      <li>
        <span><b>Location: </b>{profile.location}</span>
      </li>
      <li>
        <span><b>Format: </b>{profile.workFormat}</span>
      </li>
    </ul>
    <p class="my-2 self-start text-md">{profile.description}</p>
    <p class="my-2 self-start text-md">{profile.availability}</p>
  </section>
  <section class="mt-8">
    <h2 class="text-2xl font-semibold mb-2 sm:mb-8">Skills</h2>
    <ul class="flex flex-wrap gap-2 mb-8 sm:mb-16">
      {technologies.map((technology) => (
          <li class="px-3 py-1 rounded-md bg-skin-base/5 text-sm whitespace-nowrap">
            {technology}
          </li>
      ))}
    </ul>
  </section>
</BaseLayout>
