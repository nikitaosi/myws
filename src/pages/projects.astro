---
export const prerender = false;
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import type {ComponentProps} from 'astro/types';

const title = "Projects";
const projects: ComponentProps<typeof ProjectCard>['content'][] = [
  {
    title: 'My website',
    description: 'Personal portfolio built with Astro and Tailwind CSS, with server-rendered themes.',
    repositories: [
      { label: 'Source code', url: 'https://github.com/nikitaosi/myws', private: false },
    ],
    technologies: ['Astro', 'Tailwind CSS'],
  },
  {
    title: 'Expense tracker',
    description: 'Full-stack expense tracker with search, filters and secure sign-in. Expenses are stored in PostgreSQL and managed through a separate API using ConnectRPC and Protobuf.',
    repositories: [
      { label: 'Frontend', url: 'https://github.com/nikitaosi/extra', private: false },
      { label: 'Backend', url: 'https://github.com/nikitaosi/extra-api', private: false },
    ],
    technologies: ['Next.js', 'TypeScript', 'React Query', 'Fastify', 'ConnectRPC', 'PostgreSQL'],
  },
  {
    title: 'ChatGPT Wrapper',
    description: 'AI chat application with streaming responses and a built-in demo mode. Live responses from the OpenAI Responses API can be enabled with a server-side API key.',
    repositories: [
      { label: 'Source code', url: 'https://github.com/nikitaosi/chatgpt-wrapper', private: false },
    ],
    technologies: ['Next.js', 'TypeScript', 'OpenAI API', 'Vitest'],
  },
];
---

<BaseLayout title={`${title} — Nikita Osipov`} description="Explore Nikita Osipov's projects: an Astro portfolio, a full-stack expense tracker and an AI chat application with streaming responses. Includes source code links.">
  <section class="flex flex-col items-center justify-center py-14 text-left">
    <h2 class="text-2xl font-semibold self-start">{title}</h2>
    <div class="grid grid-cols-1 gap-8 mt-10 w-full">
      {projects.map((project) => <ProjectCard content={project} />)}
    </div>
  </section>
</BaseLayout>
