---
export const prerender = false;
import {getSecret} from 'astro:env/server';
import BaseLayout from '../layouts/BaseLayout.astro';
import {contactReady, submitContact} from '../lib/contact';

const config = {
  siteKey: getSecret('TURNSTILE_SITE_KEY'),
  turnstileSecret: getSecret('TURNSTILE_SECRET_KEY'),
  resendKey: getSecret('RESEND_API_KEY'),
  from: getSecret('CONTACT_FROM_EMAIL'),
};
const ready = contactReady(config);
const outcome = Astro.request.method === 'POST' ? await submitContact(Astro.request, config) : undefined;
if (outcome) Astro.response.status = outcome.status;
Astro.response.headers.set('Cache-Control', 'no-store');
const values = outcome?.values ?? {name: '', email: '', message: ''};
---
<BaseLayout title="Get in touch — Nikita Osipov" description="Contact Nikita Osipov about a remote frontend role or a React and Next.js contract.">
  <section class="py-14">
    <h1 class="text-2xl font-semibold">Get in touch</h1>
    <p class="mt-3">Have a React or Next.js project, a UI issue to solve, or a role in mind? Tell me a little about it.</p>
    <p class="mt-4 text-sm">You can also <a class="text-skin-accent underline underline-offset-4" href="mailto:nikitaosipov.51@gmail.com">email me directly</a> or <a class="text-skin-accent underline underline-offset-4" href="https://t.me/osi_nv" target="_blank" rel="noopener noreferrer">message me on Telegram ↗</a>.</p>
    {outcome && <p role={outcome.sent ? 'status' : 'alert'} class="my-6 rounded-lg border border-skin-base/20 p-4">{outcome.feedback}</p>}
    {outcome?.sent ? <a href="/contact/" class="inline-block mt-4 text-skin-accent underline underline-offset-4">Send another message</a> : <>
      {!ready && <p role="status" class="mt-6 rounded-lg bg-skin-base/5 p-4 text-sm">The form is temporarily unavailable. Please use email or Telegram above.</p>}
      <form id="contact-form" method="post" action="/contact/" class="mt-8 space-y-5" data-sitekey={ready ? config.siteKey : undefined}>
        <div>
          <label for="contact-name" class="block mb-2 text-sm font-medium">Name <span class="font-normal text-skin-base/70">(optional)</span></label>
          <input id="contact-name" name="name" autocomplete="name" maxlength="80" value={values.name} class="contact-field" />
        </div>
        <div>
          <label for="contact-email" class="block mb-2 text-sm font-medium">Email</label>
          <input id="contact-email" name="email" type="email" autocomplete="email" maxlength="254" required value={values.email} class="contact-field" />
        </div>
        <div>
          <label for="contact-message" class="block mb-2 text-sm font-medium">Message</label>
          <textarea id="contact-message" name="message" rows="6" minlength="10" maxlength="5000" required class="contact-field" placeholder="What are you working on, and how can I help?">{values.message}</textarea>
        </div>
        <div hidden aria-hidden="true">
          <label for="contact-website">Website</label>
          <input id="contact-website" name="website" tabindex="-1" autocomplete="off" />
        </div>
        {ready && <>
          <div id="contact-captcha"></div>
          <p id="contact-verification" role="status" aria-live="polite" class="text-sm text-skin-base/70">Loading verification…</p>
          <noscript><p class="text-sm">JavaScript is needed for verification. Please use email or Telegram instead.</p></noscript>
        </>}
        <p class="text-sm text-skin-base/70">Your details will only be used to respond to this message.</p>
        <button id="contact-submit" type="submit" disabled class="inline-flex items-center px-4 py-2 text-sm rounded-lg bg-skin-accent text-skin-inverted font-semibold focus-visible:outline-2 focus-visible:outline-offset-4 hover:opacity-85 disabled:opacity-50 disabled:cursor-not-allowed">Send message</button>
      </form>
    </>}
  </section>
</BaseLayout>
<style>
  .contact-field {
    display: block;
    width: 100%;
    padding: .65rem .8rem;
    border: 1px solid rgba(var(--color-text-base), .25);
    border-radius: .5rem;
    background: rgb(var(--color-fill));
    color: rgb(var(--color-text-base));
    font: inherit;
  }
  .contact-field:focus-visible {outline: 2px solid rgb(var(--color-accent)); outline-offset: 2px;}
  .contact-field::placeholder {color: rgba(var(--color-text-base), .6);}
  textarea {resize: vertical; min-height: 10rem;}
</style>
<script>
  import '../lib/contact-form';
</script>
